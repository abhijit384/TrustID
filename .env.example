# ==============================================================================
# TRUSTID Root Environment Variables Template
# ==============================================================================

# Backend Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./trustid.db

# Google Gemini Vision API Key
GEMINI_API_KEY=

# Gemini Vision Model
GEMINI_MODEL=gemini-3.5-flash

# Supabase Storage & Database (Optional Production Integration)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=

# Demo Mode Flag
DEMO_MODE=true

# Frontend API Base URL (For Vite in production)
VITE_API_BASE_URL=
