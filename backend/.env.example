# ==============================================================================
# TRUSTID Backend Environment Variables (Production & Deployment Template)
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for production e.g. Supabase / Neon / Render)
# Local example: sqlite:///./trustid.db
# Production example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=

# Google Gemini Vision API Key (Required for Multimodal Forensic Analysis)
GEMINI_API_KEY=

# Gemini Vision Model (Default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Supabase Cloud Storage (Optional production file storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example: https://trustid.vercel.app,http://localhost:5173
CORS_ORIGINS=

# JWT Secret Key for Session Authentication
JWT_SECRET=

# Demo Mode (true enables offline demo login fallback for evaluations)
DEMO_MODE=false

# Optional SMTP Email Configuration for OTP Verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
